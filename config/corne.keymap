#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        behaviors {
                hm: homerow_mods {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS";
                        #binding-cells = <2>;
                        tapping-term-ms = <300>;
                        quick-tap-ms = <0>;
                        flavor = "tap-preferred";
                        bindings = <&kp>, <&kp>;
                };
        };
        keymap {
                compatible = "zmk,keymap";
                default_layer {
                        bindings = <
                &kp ESC   &kp SQT  &kp COMMA   &kp DOT     &kp P      &kp Y      &kp F   &kp G      &kp C      &kp R       &kp L &kp BSPC
                &kp TAB   &kp A    &hm LCTRL O &hm LALT E  &hm LGUI U &kp I      &kp D   &hm RGUI H &hm RALT T &hm RCTRL N &kp S &kp FSLH
                &kp LSHFT &kp SEMI &kp Q       &kp J       &kp K      &kp X      &kp B   &kp M      &kp W      &kp V       &kp Z &kp RSHIFT
                                               &none       &mo 1      &kp SPACE  &kp RET &mo 2      &none
                        >;
                };
                lower_layer {
                        bindings = <
                &trans     &kp N1  &kp N2    &kp N3   &kp N4   &kp N5      &kp N6       &kp N7    &kp N8      &kp N9   &kp N0     &trans
                &kp F1     &kp F2  &kp F3    &kp F4   &kp F5   &F6         &none        &kp LEFT  &kp DOWN    &kp UP   &kp RIGHT  &trans
                &kp F7     &kp F8  &kp F9    &kp F10  &kp F11  &kp 12      &kp KP_PLUS  &kp MINUS &kp EQUAL   &kp LBKT &kp RBKT   &kp BSLH
                                             &trans    &trans  &trans      &trans       &trans    &trans
                        >;
                };
                raise_layer {
                        bindings = <
                &trans   &kp EXCL   &kp AT            &kp HASH          &kp DLLR        &kp PRCNT         &kp CARET    &kp AMPS          &kp KP_MULTIPLY   &kp LPAR         &kp RPAR   &kp BSPC
                &trans   &kp UNDER  &kp PLUS          &kp LBRC          &kp RBRC        &kp PIPE          &kp MINUS    &hm RGUI EQUAL    &hm RALT LBKT     &hm RCTRL RBKT   &kp BSLH   &kp GRAVE
                &trans   &trans     &bt BT_CLEAR      &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2      &trans       &kp MINUS         &kp KP_PLUS       &kp LBRC         &kp RBRC   &kp TILDE
                                                      &trans            &trans          &trans            &trans       &trans            &trans
                        >;
                };
        };
};
